# Vercel KV (auto-set when you link a KV store in Vercel Dashboard → Storage)
# No manual setup needed — just create a KV database and connect it to this project.
KV_REST_API_URL=https://your-kv-url.kv.vercel-storage.com
KV_REST_API_TOKEN=your-token-here

# Solana treasury wallet — receives all platform fees (0.002 SOL per join)
TREASURY_WALLET=your-solana-pubkey-here

# Solana RPC — Helius recommended for reliability
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-key

# Public base URL (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://agentroom.vercel.app
